{
  "name": "@luthics/domain-grep",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Find available domains by keyword with prefix/suffix combinations — RDAP + WHOIS, no API key, pluggable providers",
  "type": "module",
  "bin": {
    "domain-grep": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir dist --target node && chmod +x dist/index.js",
    "compile": "bun build --compile index.ts --outfile domain-grep",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luthics/domain-grep.git"
  },
  "homepage": "https://github.com/Luthics/domain-grep#readme",
  "bugs": {
    "url": "https://github.com/Luthics/domain-grep/issues"
  },
  "keywords": [
    "domain",
    "domain-availability",
    "domain-checker",
    "rdap",
    "whois",
    "cli",
    "bun"
  ],
  "author": "Luthics",
  "license": "MIT"
}
